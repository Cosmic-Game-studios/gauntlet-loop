{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/studio-session-start.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/studio-pre-compact.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./studio/.keys/**)",
      "Read(./studio/.qa-heldout/**)"
    ]
  }
}